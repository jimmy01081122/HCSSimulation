FROM ubuntu:22.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install gem5 build dependencies based on official gem5 requirements
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    scons \
    g++ \
    m4 \
    python3 \
    python3-dev \
    python3-pip \
    zlib1g-dev \
    libgoogle-perftools-dev \
    protobuf-compiler \
    libprotobuf-dev \
    libpng-dev \
    libelf-dev \
    pkg-config \
    cmake \
    libboost-all-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory inside the container
WORKDIR /gem5

# Default command is interactive shell
CMD ["/bin/bash"]
